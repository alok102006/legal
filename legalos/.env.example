# Root-level environment variables
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: more keys from other Google projects/accounts, comma-separated. The free tier allows only
# 20 requests per model per day per project; when one key is used up the next one is tried automatically.
GEMINI_API_KEYS=
# Models tried in order when the primary model is out of quota (each has its own daily quota)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
POSTGRES_USER=legalos
POSTGRES_PASSWORD=legalos_secure_password
POSTGRES_DB=legalos
DATABASE_URL=postgresql+asyncpg://legalos:legalos_secure_password@localhost:5435/legalos
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
FRONTEND_URL=http://localhost:5173
HF_HOME=./model_cache
SENTENCE_TRANSFORMERS_HOME=./model_cache

# Live GST registry for supplier checks (Vendors). Leave empty to run offline checks only.
# GST_API_PROVIDER = sandbox | generic | none. generic = any GET {base}/{gstin} API with an API-key header.
GST_API_PROVIDER=
GST_API_KEY=
GST_API_SECRET=
GST_API_BASE_URL=
